{
  "name": "@lead-me/data-access",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./admin/*": "./src/admin/*.ts",
    "./home/*": "./src/home/*.ts",
    "./content/*": "./src/content/*.ts",
    "./user/*": "./src/user/*.ts",
    "./common/*": "./src/common/*.ts"
  },
  "scripts": {
